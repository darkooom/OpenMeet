{
  "name": "openmeet",
  "version": "0.1.0",
  "description": "OpenMeet – open-source, self-hostable, Cloudflare-native scheduling platform.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "deploy": "node scripts/deploy.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types src/server/worker-configuration.d.ts --include-runtime false",
    "check:deploy": "vite build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "audit": "npm audit --omit=dev --audit-level=high",
    "readme:screens": "vite build && node scripts/readme-screens.mjs"
  },
  "cloudflare": {
    "bindings": {
      "SETUP_TOKEN": {
        "description": "One-time bootstrap secret that protects the first-run setup wizard. Generate with `openssl rand -hex 24` and keep it private — you type it into the wizard once. It is never shown in URLs or logs."
      },
      "ENCRYPTION_KEY": {
        "description": "Root key used to encrypt OAuth tokens and provider credentials at rest (AES-256-GCM). Generate with `openssl rand -hex 32`. **Do not change it later**, otherwise stored integrations must be reconnected."
      },
      "DB": {
        "description": "D1 database holding all OpenMeet data. Created automatically."
      }
    }
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tanstack/react-query": "^5.108.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261124.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^4.1.12",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": false
  }
}
